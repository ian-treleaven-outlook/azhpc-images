#!/bin/bash
# Long-flag implementation of the azhpc CLI spec.

set -euo pipefail

VERSION="0.1.0"
BUILD_COMMIT="dev"
BUILD_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

spec=""
vendor=""
gpu=""
os=""
fips=false
dry_run=false
verbose=false
log_format=""
show_version=false

#Load the log functions
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/utils/logger.sh"

print_help() {
    cat <<'EOF'
azhpc - Build HPC/AI Linux images for Azure

USAGE:
    azhpc [OPTIONS]
    azhpc --help

OPTIONS:
    --spec <PATH>           Path to versions.json (optional)
    --vendor <VENDOR>       Hardware vendor: NVidia | AMD 
    --gpu <SKU>             Target GPU. Values with dedicated build paths
                            are marked (*); others use the generic path.
                                NVidia : GB200* | GB300* | NCv6* | V100*
                                         A100 | H100 | H200 | VR200
                                AMD    : MI300 | MI400 | MI500
    --os <OS>               Target OS: Ubuntu24 | Ubuntu22 | Azure3 |
                                       Alma9 | Alma8 | Rocky9 | Rocky8 
    --fips                  Build a FIPS-compliant image (default: non-FIPS)
    --dry-run               Validate args and print build plan; do not build
    -v, --verbose           Verbose (debug-level) logging
    --log-format <FORMAT>   Log format: text | json
                            (default: text if stdout is a TTY, else json)
    --version               Print version information and exit
    -h, --help              Show this help message and exit

EXIT STATUS:
    0  Image built successfully
    1  Invalid arguments or unsupported vendor/GPU combination
    2  Specification file missing or malformed
    3  Build failure
EOF
}

die() {
    log_error "cli" "$1"
    exit "${2:-1}"
}

# Long flag parser
need_value() {
    # Ensures a flag that requires a value actually got one.
    [[ $# -ge 2 && -n "${2:-}" && "${2:0:1}" != "-" ]] \
        || die "option $1 requires an argument" 1
}
while [[ $# -gt 0 ]]; do
    case "$1" in
        --spec)         need_value "$@"; spec="$2"; shift 2 ;;
        --spec=*)       spec="${1#*=}"; shift ;;
        --vendor)       need_value "$@"; vendor="$2"; shift 2 ;;
        --vendor=*)     vendor="${1#*=}"; shift ;;
        --gpu)          need_value "$@"; gpu="$2"; shift 2 ;;
        --gpu=*)        gpu="${1#*=}"; shift ;;
        --os)           need_value "$@"; os="$2"; shift 2 ;;
        --os=*)         os="${1#*=}"; shift ;;
        --fips)         fips=true; shift ;;
        --dry-run)      dry_run=true; shift ;;
        -v|--verbose)   verbose=true; shift ;;
        --log-format)   need_value "$@"; log_format="$2"; shift 2 ;;
        --log-format=*) log_format="${1#*=}"; shift ;;
        --version)      show_version=true; shift ;;
        -h|--help)      print_help; exit 0 ;;
        --)             shift; break ;;
        -*|--*)         die "unknown option $1 (use --help)" 1 ;;
        *)              die "unexpected positional argument '$1'" 1 ;;
    esac
done

# Display version info
if [[ "$show_version" == true ]]; then
    bash_short="${BASH_VERSION%%(*}"
    arch="$(uname -m)"
    case "$arch" in
        x86_64)  arch=amd64 ;;
        aarch64) arch=arm64 ;;
    esac
    platform="$(uname -s | tr '[:upper:]' '[:lower:]')/${arch}"
    cat <<EOF
azhpc $VERSION (bash${bash_short}, ${platform})
  commit:   $BUILD_COMMIT
  built:    $BUILD_DATE
  runtime:  GNU Bash ${bash_short}
EOF
    exit 0
fi
# Required args
[[ -n "$vendor" ]] || die "--vendor is required" 1
[[ -n "$gpu"    ]] || die "--gpu is required" 1
[[ -n "$os"     ]] || die "--os is required" 1

# Vendor / GPU validation
case "$vendor" in
    NVidia)
        case "$gpu" in
            GB200|GB300|NCv6|V100|A100|H100|H200|VR200) ;;
            *) die "GPU '$gpu' not valid for vendor NVidia" 1 ;;
        esac ;;
    AMD)
        case "$gpu" in
            MI300|MI400|MI500) ;;
            *) die "GPU '$gpu' not valid for vendor AMD" 1 ;;
        esac ;;
    *) die "unsupported vendor '$vendor' (NVidia|AMD)" 1 ;;
esac

# Warn if the GPU doesn't have a dedicated build path
case "$gpu" in
    GB200|GB300|NCv6|V100) ;;  # dedicated path
    *) log_warn "resolve-config" "GPU '$gpu' has no dedicated build path; using generic $vendor build" ;;
esac

# OS validation
case "$os" in
    Ubuntu24|Ubuntu22|Azure3|Alma9|Alma8|Rocky9|Rocky8) ;;
    *) die "unsupported os '$os' (Ubuntu24|Ubuntu22|Azure3|Alma9|Alma8|Rocky9|Rocky8)" 1 ;;
esac

# Log format default + validation
if [[ -z "$log_format" ]]; then
    if [[ -t 1 ]]; then log_format=text; else log_format=json; fi
fi
case "$log_format" in
    text|json) ;;
    *) die "invalid log format '$log_format' (text|json)" 1 ;;
esac

# Spec file validation
if [[ -n "$spec" ]]; then
    [[ -f "$spec" ]] || die "spec file not found: $spec" 2
    if command -v jq >/dev/null 2>&1; then
        jq empty "$spec" >/dev/null 2>&1 || die "spec file is malformed JSON: $spec" 2
    fi
fi

effective_spec="${spec:-<azhpc-images default versions.json>}"

export VERSION BUILD_COMMIT VENDOR="$vendor" GPU="$gpu" OS="$os" FIPS="$fips"
export LOG_FORMAT="$log_format"
export RUN_ID
export LOG_FILE="${LOG_FILE:-/tmp/azhpc-${RUN_ID}.log}"
mkdir -p "$(dirname "$LOG_FILE")"
if [[ "$verbose" == true ]]; then 
    export LOG_LEVEL=debug; 
fi

log_info "resolve-config" "Effective build: vendor=$vendor gpu=$gpu os=$os fips=$fips spec=$effective_spec"
log_debug "resolve-config" "log_format=$log_format dry_run=$dry_run run_id=$RUN_ID"

if [[ "$dry_run" == true ]]; then
    log_info "dry-run" "Dry-run requested; not executing build steps"
    exit 0
fi

# Translate CLI flags into install.sh inputs
case "$os" in
    Ubuntu24) distro_dir="distros/ubuntu24.04" ;;
    Ubuntu22) distro_dir="distros/ubuntu22.04" ;;
    Alma9)    distro_dir="distros/almalinux9.7" ;;
    Alma8)    distro_dir="distros/almalinux8.10" ;;
    Rocky9)   distro_dir="distros/rocky9.7" ;;
    Rocky8)   distro_dir="distros/rocky8.10" ;;
    Azure3)   distro_dir="distros/azurelinux3.0" ;;
    *)        die "internal: no distro mapping for '$os'" 1 ;;
esac

case "$vendor" in
    NVidia) gpu_arg="NVIDIA" ;;
    AMD)    gpu_arg="AMD" ;;
    *)      die "internal: no GPU arg mapping for vendor '$vendor'" 1 ;;
esac

sku_arg="$gpu" 

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log_info "build-image" "Invoking $distro_dir/install.sh GPU=$gpu_arg GPU=$sku_arg"

# Build the image
(
    cd "$repo_root/$distro_dir"
    ./install.sh "$gpu_arg" "$sku_arg"
) || die "build failed in $distro_dir/install.sh" 3

log_info "build-image" "Image built successfully"