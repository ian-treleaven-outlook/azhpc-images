#%Module 1.0
#
#  MVAPICH 4.1
#
conflict        mpi
prepend-path    PATH            /opt/mvapich-4.1/bin
prepend-path    LD_LIBRARY_PATH /opt/mvapich-4.1/lib:/opt/libfabric/lib
prepend-path    MANPATH         /opt/mvapich-4.1/share/man
setenv          MPI_BIN         /opt/mvapich-4.1/bin
setenv          MPI_INCLUDE     /opt/mvapich-4.1/include
setenv          MPI_LIB         /opt/mvapich-4.1/lib
setenv          MPI_MAN         /opt/mvapich-4.1/share/man
setenv          MPI_HOME        /opt/mvapich-4.1
setenv          FI_PROVIDER tcp
setenv          MPIR_CVAR_CH4_CMA_ENABLE 0
